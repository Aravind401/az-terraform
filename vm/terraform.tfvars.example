resource_group_name           = "rg-app-demo"
location                      = "swedencentral"
virtual_machine_name          = "vm-app-demo"
computer_name                 = "vm-app-demo"
vm_size                       = "Standard_B2ats_v2"
admin_username                = "azureuser"
admin_ssh_public_key          = "ssh-rsa "
virtual_network_name          = "vnet-vm-demo"
virtual_network_address_space = ["10.10.0.0/16"]
subnet_name                   = "snet-vm"
subnet_address_prefixes       = ["10.10.1.0/24"]
network_security_group_name   = "nsg-vm-demo"
public_ip_name                = "pip-vm-demo"
network_interface_name        = "nic-vm-demo"
ssh_source_address_prefix     = "203.0.113.10/32"
tags = {
  environment = "dev"
  managed_by  = "terraform"
}
