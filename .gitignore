# Terraform working directories and downloaded providers
**/.terraform/*

# Terraform state (may contain sensitive values)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files may contain secrets; keep only explicitly named examples
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local Terraform CLI configuration
.terraformrc
terraform.rc

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
